# ─── NEEJEE Platform Environment Variables ───
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Database (use Supabase, Neon, or Railway for hosted Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/neejee?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Canonical public URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (Payments) — https://razorpay.com
RAZORPAY_KEY_ID="rzp_live_XXXXXXXX"
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXX"
RAZORPAY_WEBHOOK_SECRET=""

# RazorpayX payouts
RAZORPAYX_ACCOUNT_NUMBER=""
RAZORPAYX_WEBHOOK_SECRET=""
RAZORPAYX_MODE="test"

# Shiprocket (Shipping)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_TOKEN=""
# Configure this same >=32-char value as Shiprocket webhook Security Token.
# Shiprocket sends it in x-api-key.
SHIPROCKET_WEBHOOK_TOKEN=""

# Cloudinary (legacy/external media CDN if used)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="neejee-media"
SUPABASE_PRIVATE_AI_BUCKET="neejee-private-ai"
# Optional dedicated HMAC secret for private AI media URLs; AUTH_SECRET is the
# server-only fallback when this is not set. Must be >=32 chars when set.
AI_MEDIA_SIGNING_SECRET=""

# Algolia (Search, optional)
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""

# Klaviyo (Email Marketing)
KLAVIYO_API_KEY=""

# WATI (legacy WhatsApp provider if enabled)
WATI_API_TOKEN=""
WATI_TENANT_ID=""

# AiSensy WhatsApp
AISENSY_API_URL=""
AISENSY_API_KEY=""
# Dedicated inbound webhook secret. Configure the AiSensy callback with either
# Authorization: Bearer <secret>, x-neejee-webhook-token, or ?token=<secret>.
AISENSY_WEBHOOK_SECRET=""

# Fast2SMS DLT (India)
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID="NEEJEY"
FAST2SMS_DLT_ENTITY_ID=""
FAST2SMS_MODE="live"
# Dedicated inbound DLR secret; use Bearer/header or ?token=<secret> callback.
FAST2SMS_WEBHOOK_SECRET=""
# Template IDs are managed in DB via /admin/settings/sms.

# Replicate (AI — optional/legacy surfaces)
REPLICATE_API_TOKEN=""

# FAL (AI Mirror/Space provider where enabled)
FAL_KEY=""

# OpenAI (Gift Concierge, content assistance, autonomous best-practice research)
OPENAI_API_KEY=""
# Optional override for the approval-gated autonomous research job.
AUTONOMY_RESEARCH_MODEL="gpt-5"

# Social sign-in
GOOGLE_CLIENT_ID=""
FACEBOOK_APP_ID=""
# Never use the malformed name FACEBOOK_APP_IDFACEBOOK_APP_ID.

# Google Analytics
NEXT_PUBLIC_GA_ID=""

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=""

# Sentry (Errors)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Transactional email / journal curation
NIDHI_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM="NEEJEE <hello@neejee.com>"

# Cron auth — generate independently and keep server-only
CRON_SECRET=""

# Optional Super Admin settings sync back to Vercel. Server-only.
VERCEL_ACCESS_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
