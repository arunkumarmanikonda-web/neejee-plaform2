{
  "extends": ["next/core-web-vitals"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "react/no-unescaped-entities": "off"
  },
  "overrides": [
    {
      "files": [
        "app/admin/assets/page.tsx",
        "app/admin/categories/page.tsx",
        "app/admin/crafts/page.tsx",
        "app/admin/editorial-blocks/*/page.tsx",
        "app/admin/inventory/page.tsx",
        "app/admin/journal/page.tsx",
        "app/admin/journal/*/page.tsx",
        "app/admin/legal-signatories/page.tsx",
        "app/admin/marketing-studio/page.tsx",
        "app/agreement/admin/sellers/*/AgreementPrintClient.tsx",
        "app/agreement/admin/sellers/*/AgreementPrintClientV2.tsx",
        "app/agreement/public/sellers/*/sign/SellerAgreementSignClient.tsx",
        "app/seller/(portal)/inventory/submit/page.tsx",
        "app/seller/(portal)/orders/page.tsx",
        "app/vendor/(portal)/ai-photos/page.tsx",
        "components/admin/AiPhotoStudio.tsx",
        "components/admin/ImageUploader.tsx",
        "components/admin/VariantImageManager.tsx",
        "components/analytics/PixelScripts.tsx"
      ],
      "rules": {
        "@next/next/no-img-element": "off"
      }
    },
    {
      "files": [
        "app/(auth)/login/page.tsx",
        "app/admin/drops/*/page.tsx",
        "app/admin/finance/bank-reconciliation/*/page.tsx",
        "app/admin/finance/bills/page.tsx",
        "app/admin/finance/customer-ledger/*/page.tsx",
        "app/admin/finance/expenses/page.tsx",
        "app/admin/finance/ledger/page.tsx",
        "app/admin/finance/period-close/page.tsx",
        "app/admin/finance/pnl/page.tsx",
        "app/admin/finance/sales-invoices/page.tsx",
        "app/admin/finance/sales-invoices/*/page.tsx",
        "app/admin/finance/vendor-ledger/page.tsx",
        "app/admin/payroll/employees/*/page.tsx",
        "app/admin/payroll/fnf/*/page.tsx",
        "app/admin/products/*/page.tsx",
        "app/admin/sellers/*/page.tsx",
        "app/admin/sellers/*/agreement-workbench/page.tsx",
        "app/admin/vendors/*/page.tsx",
        "app/agreement/public/sellers/*/sign/SellerAgreementSignClient.tsx",
        "app/sell/apply/page.tsx",
        "components/admin/AiPhotoStudio.tsx",
        "components/admin/CatalogueBuilderPage.tsx",
        "components/admin/MerchandisingWorkspacePage.tsx",
        "components/admin/SellerCommercialLifecycleDock.tsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
